# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BACKEND_API_URL: The base URL for the backend API.
# In development, this is http://localhost:3000
VITE_BACKEND_API_URL="http://localhost:3000"

JWT_ACCESS_SECRET="ACCESS_TOKEN_SECRET"
JWT_REFRESH_SECRET="REFRESH_TOKEN_SECRET"

# DATABASE_URL: The connection string for the external PostgreSQL database.
DATABASE_URL=
DIRECT_URL=

# Supabase SDK Credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Finnhub API credentials for live news update feature
FINNHUB_API_KEY=
BINANCE_API_KEY=
ALPHA_VANTAGE_API_KEY=

